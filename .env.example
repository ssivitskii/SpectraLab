SPECTRALAB_DATA_DIR=./data
SPECTRALAB_ARTIFACTS_DIR=./artifacts
SPECTRALAB_REPORTS_DIR=./reports
SPECTRALAB_CORS_ORIGINS=["http://localhost:5173"]
# Optional offline reference; keep unset for the reproducible demo fixture.
# SPECTRALAB_REFERENCE_CACHE=./data/reference/nist_neutral_350_800/catalog.json
# SPECTRALAB_REFERENCE_SHA256=<sha256 of the cache file>
# Start a separate worker with make worker to execute browser research jobs.
SPECTRALAB_JOB_TIMEOUT_SECONDS=3600
SPECTRALAB_WORKER_MEMORY_MB=4096
