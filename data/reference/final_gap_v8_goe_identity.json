  "new_primary_findings": [
    {
      "id": "GoeDV_composition_source",
      "status": "verified_metadata",
      "evidence": "exact_metadata_prefixes.json",
      "fact": "All three original SuperCam GoeDV observations name Fe-Oxide / Goethite and composition_source LANL EES; geology and location are blank.",
      "interpretation_limit": "The XML defines composition source as the source of compositional information (publication/instrument/other source), not a procurement or lot field. LANL EES does not prove a natural specimen or a stock distinct from Sigma GOE100."
    },
    {
      "id": "100-Goethite_assumed_purity",
      "status": "verified_metadata",
      "evidence": "exact_metadata_prefixes.json",
      "fact": "All three original SuperCam 100-Goethite observations name goethite / Pure chemical, blank composition_source and geology, and location text Assuming pure (no independent chemistry).",
      "interpretation_limit": "This is the SuperCam target label, not an established alias for David GOE100. Do not transfer the David assay, infer Sigma stock, or use its nominal purity as an analytical bound."
    },
    {
      "id": "DV_family_context",
      "status": "verified_metadata_not_identity",
      "evidence": "supercam_metadata_range_access.json",
      "fact": "Two extracted shifted HemDV metadata rows list LANL EES and a hematite/chlorite/quartz mixture, with Oolitic in location.",
      "interpretation_limit": "Information about another DV target does not establish GoeDV mineral origin or expand the suffix DV."
    },
    {
      "id": "individual_xml_conflict",
      "status": "unresolved_metadata_inconsistency",
      "evidence": [
        "supercam_goedv_label.xml",
        "supercam_100goethite_label.xml"
      ],
      "fact": "Both individual XML descriptions read Mixture / SCCT / Basalt despite target names GoeDV and 100-Goethite and the reference-table descriptions above.",
      "interpretation_limit": "These repeated descriptions are not reliable evidence of stock origin. Their dates and instrument configuration remain metadata; none are used to establish independence."
    },
    {
      "id": "repository_versions",
      "status": "verified_inventory",
      "fact": "The LANL, IRAP, tables and Mn records each expose one published version. No newly attached preparation/lot document was found in these inventories.",
      "interpretation_limit": "This bounded check does not prove that documents do not exist elsewhere."
    },
    {
      "id": "2026_DV_reuse",
      "status": "bounded_cross_publication_check",
      "evidence": [
        "manelski_web_extract.json",
        "manelski2026_metadata.json"
      ],
      "fact": "Manelski2026 (10.1029/2026JE009769) uses IlmDV as an ilmenite endmember. Its dataset inventory supplies separate calibration metadata plus spectra.",
      "interpretation_limit": "The inspected paper and inventory do not link IlmDV or GoeDV to GOE100, and a general Brammer statement is not assigned to GoeDV. No spectrum files from this record were opened."
    }
  ],
